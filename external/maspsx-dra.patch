+    def _expand_at_store_delay_slot(
+        self, op: str, operand: str, r_dest: str
+    ):
+        """aspsx expands a bare symbolic store through `$at`
+        (`lui $at,%hi(sym)` / `<store> $r,%lo(sym)($at)`) and, when the store is
+        immediately followed by an unconditional return jump (`j $31`/`jr`),
+        schedules the store into the jump's delay slot.  GNU as can expand the
+        store but cannot reorder it across the branch, so emulate that here.
+        Returns the replacement lines, or None to leave the line for the
+        assembler (previous behaviour)."""
+        if op not in ("sw", "sh", "sb"):
+            return None
+        # Locate the immediately following instruction (skipping .set/labels).
+        label_pattern = r"^\s*([$.\w]+):\s*$"
+        i = self.line_index + 1
+        while i < len(self.lines) and (
+            not is_instruction(self.lines[i], ignore_set=True)
+            or re.match(label_pattern, self.lines[i])
+        ):
+            i += 1
+
+        if i >= len(self.lines):
+            return None
+        nxt = self.lines[i]
+        parts = nxt.split()
+        if len(parts) < 2 or parts[0] not in ("j", "jr") or parts[1] not in (
+            "$31",
+            "$ra",
+        ):
+            return None
+        # A local label is safe to cross unless an in-function transfer targets it.
+        local_labels = {
+            match.group(1)
+            for line in self.lines[self.line_index + 1 : i]
+            if (match := re.match(label_pattern, line))
+        }
+        if local_labels:
+            function_start = None
+            for j in range(self.line_index, -1, -1):
+                if re.match(r"^\s*\.ent\b", strip_comments(self.lines[j])):
+                    function_start = j + 1
+                    break
+
+            if function_start is not None:
+                function_end = len(self.lines)
+                for j in range(i + 1, len(self.lines)):
+                    line = strip_comments(self.lines[j])
+                    if re.match(r"^\s*\.end\b", line) or re.match(
+                        r"^\s*\.ent\b", line
+                    ):
+                        function_end = j
+                        break
+
+                for line in self.lines[function_start:function_end]:
+                    parts = strip_comments(line).split(None, 1)
+                    if (
+                        len(parts) >= 2
+                        and parts[0] in branch_target_mnemonics
+                        and parts[1].rsplit(",", 1)[-1].strip() in local_labels
+                    ):
+                        return None
+
+        # If cc1 already emitted an explicit delay-slot instruction (it wraps
+        # the jump in `.set noreorder` and puts the filler right after it),
+        # leave the store alone -- aspsx keeps that filler in the slot.
+        if i + 1 < len(self.lines) and is_instruction(
+            self.lines[i + 1], ignore_set=True, ignore_label=True
+        ):
+            return None
+        self.skip_instruction_indices.add(i)
+        return [
+            "# EXPAND_AT_STORE_DELAY_SLOT START",
+            ".set\tnoat",
+            f"lui\t$at,%hi({operand})",
+            nxt,
+            f"{op}\t{r_dest},%lo({operand})($at)",
+            ".set\tat",
+            "# EXPAND_AT_STORE_DELAY_SLOT END",
+        ]
 
